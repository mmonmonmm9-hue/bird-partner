# คัดลอกไฟล์นี้เป็น ".env" แล้วกรอกค่าที่ต้องการ (ห้ามนำ .env ขึ้น git และห้ามส่งให้ใคร)
# Copy this file to ".env". Never commit .env and never put these values in frontend code.

# ---------- พื้นฐาน ----------
PORT=3001
# ที่อยู่เว็บจริงเมื่อขึ้น production เช่น https://partner.birdexpress.co.th (ใช้ตรวจ CSRF/คุกกี้)
APP_ORIGIN=
# production เท่านั้น: NODE_ENV=production และต้องมี DATA_KEY
NODE_ENV=
# กุญแจเข้ารหัสเลขบัตร 32 ไบต์แบบ base64 สร้างด้วย:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ตอนพัฒนาไม่ต้องใส่ ระบบสร้าง data/dev-data.key ให้เอง แต่ production ต้องใส่เอง และห้ามทำหาย (ทำหาย = ถอดรหัสเลขบัตรเก่าไม่ได้)
DATA_KEY=

# ---------- AI (Claude) ----------
# ไม่ใส่ = ใช้โหมดสำรองแบบกฎ (ไม่ใช่ AI จริง)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---------- บัญชีเจ้าหน้าที่ (admin) ----------
# ไม่ใส่ = ระบบสุ่มรหัสผ่านให้และพิมพ์ครั้งเดียวในหน้าต่างเซิร์ฟเวอร์ตอนเริ่มครั้งแรก
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- อีเมลส่งรหัสยืนยัน (SMTP) ----------
# ไม่ใส่ = โหมดทดสอบ: รหัสถูกพิมพ์ในหน้าต่างเซิร์ฟเวอร์และแสดงบนหน้าเว็บ (ใช้ได้เฉพาะตอนพัฒนา ไม่ใช่ production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bird Partner <no-reply@your-domain>"

# ---------- Google Sheets ----------
# ID ของ Google Sheet "Bird Partner Database" (ส่วนระหว่าง /d/ และ /edit ในลิงก์)
GOOGLE_SHEET_ID=
# เลือกอย่างใดอย่างหนึ่ง: ไฟล์ JSON ของ service account หรือเนื้อหา JSON ทั้งก้อน
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------- อื่น ๆ ----------
# จำนวนข้อความแชตสูงสุดต่อนาทีต่อ IP (แต่ละข้อความอาจเสียค่า AI)
CHAT_RATE_PER_MIN=40

# ---------- ขึ้นเซิร์ฟเวอร์จริง (docker compose) ----------
# ชื่อโดเมนของเว็บ เช่น partner.birdexpress.co.th (ต้องชี้ DNS มาที่เซิร์ฟเวอร์ก่อน) Caddy จะขอใบรับรอง HTTPS ให้เอง
APP_DOMAIN=
# ถ้าใช้ docker compose ให้ใส่ GOOGLE_APPLICATION_CREDENTIALS=/secrets/sheets-key.json (ไฟล์คีย์วางไว้ที่ /srv/bird-secrets บนเซิร์ฟเวอร์)
